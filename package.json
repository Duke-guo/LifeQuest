{
  "name": "lifequest",
  "version": "0.1.0",
  "description": "现实游戏化生活管理应用：日记 / 日历 / 待办 / 笔记 / 活动计划，本地优先，数据是自己的普通文件",
  "license": "MIT",
  "author": {
    "name": "GuoXudong",
    "email": "Duke-guo@users.noreply.github.com"
  },
  "homepage": "https://github.com/Duke-guo/LifeQuest#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Duke-guo/LifeQuest.git"
  },
  "bugs": {
    "url": "https://github.com/Duke-guo/LifeQuest/issues"
  },
  "keywords": [
    "electron",
    "vue",
    "local-first",
    "journal",
    "calendar",
    "todo",
    "notes",
    "markdown",
    "gamification"
  ],
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win portable",
    "release": "npm run dist && node scripts/post-release.mjs"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.lifequest.app",
    "productName": "LifeQuest",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["out/**/*", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "LifeQuest-${version}-便携版.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "dmg": {
      "artifactName": "LifeQuest-${version}-mac-${arch}.${ext}",
      "title": "LifeQuest ${version}",
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "本地优先的生活管理应用：日记 / 日历 / 待办 / 笔记 / 计划",
      "description": "LifeQuest 把日记、日历、待办、笔记、活动计划聚在一处，数据以普通 Markdown / JSON 文件存放在本机，游戏化只是可选外壳。",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "appImage": {
      "artifactName": "LifeQuest-${version}-linux-x86_64.${ext}"
    }
  }
}
