{
  "name": "lifequest",
  "version": "0.1.0",
  "description": "现实游戏化生活管理应用（本地优先）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win portable",
    "release": "npm run dist && node scripts/post-release.mjs"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.lifequest.app",
    "productName": "LifeQuest",
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "LifeQuest-${version}-便携版.exe"
    }
  }
}
